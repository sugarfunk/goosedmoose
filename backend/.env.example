# ========================================
# GOOSED MOOSE E-COMMERCE - BACKEND CONFIG
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git!

# ========================================
# DATABASE
# ========================================
# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Local development example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goosedmoose

# ========================================
# MEDUSA SERVER
# ========================================
# Port for the Medusa backend API
PORT=9000

# Node environment (development, production, test)
NODE_ENV=development

# ========================================
# CORS (Cross-Origin Resource Sharing)
# ========================================
# Comma-separated list of URLs that can access the store API (your storefront)
STORE_CORS=http://localhost:3000,http://localhost:8000

# Comma-separated list of URLs that can access the admin dashboard
ADMIN_CORS=http://localhost:7001,http://localhost:5173,http://localhost:9000

# Comma-separated list of URLs for authentication
AUTH_CORS=http://localhost:7001,http://localhost:5173,http://localhost:9000

# ========================================
# SECURITY SECRETS
# ========================================
# JWT Secret - Used for authentication tokens
# Generate with: openssl rand -base64 32
# IMPORTANT: Change these in production!
JWT_SECRET=supersecret-change-this-in-production

# Cookie Secret - Used for session cookies
# Generate with: openssl rand -base64 32
# IMPORTANT: Change these in production!
COOKIE_SECRET=supersecret-change-this-in-production

# ========================================
# STRIPE PAYMENT CONFIGURATION
# ========================================
# Get your Stripe keys from: https://dashboard.stripe.com/apikeys

# Stripe Secret Key (starts with sk_test_ for testing, sk_live_ for production)
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret (for webhook signature verification)
# Get this when you create a webhook endpoint in Stripe dashboard
# Format: whsec_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ========================================
# REDIS (Optional - for caching)
# ========================================
# Redis connection URL (optional but recommended for production)
# Leave empty if you don't have Redis installed
REDIS_URL=redis://localhost:6379

# ========================================
# EMAIL / SMTP CONFIGURATION
# ========================================
# Email configuration for order confirmations, etc.
# You can configure this later when you're ready

# SMTP Host (e.g., smtp.gmail.com, smtp.sendgrid.net)
# SMTP_HOST=smtp.gmail.com

# SMTP Port (usually 587 for TLS)
# SMTP_PORT=587

# SMTP Username (your email address)
# SMTP_USER=orders@goosed.me

# SMTP Password (for Gmail, use App Password)
# SMTP_PASSWORD=your_smtp_password

# Email "From" address
# SMTP_FROM=orders@goosed.me

# SendGrid API Key (alternative to SMTP)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# SENDGRID_FROM=orders@goosed.me

# ========================================
# FILE STORAGE (Optional)
# ========================================
# By default, files are stored locally in backend/uploads
# For production, you might want to use S3 or similar

# AWS S3 Configuration (uncomment when ready)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_BUCKET=goosedmoose-products
# AWS_ENDPOINT=https://s3.amazonaws.com

# ========================================
# ADMIN USER (for initial setup)
# ========================================
# These are used by the seed script
# Create your admin user with: npx medusa user -e EMAIL -p PASSWORD
ADMIN_EMAIL=info@goosed.me
ADMIN_PASSWORD=ChangeThisSecurePassword123!

# ========================================
# STORE CONFIGURATION
# ========================================
# Store name (displayed in emails and admin)
STORE_NAME=Goosed Moose

# Store URL (your storefront)
STORE_URL=http://localhost:3000

# Admin URL
ADMIN_URL=http://localhost:7001

# ========================================
# SHIPPING CONFIGURATION
# ========================================
# These values are used by the seed script to set up shipping

# Local pickup address
PICKUP_ADDRESS_CITY=Canton
PICKUP_ADDRESS_STATE=GA
PICKUP_ADDRESS_ZIP=30114
PICKUP_ADDRESS_LINE1=Macedonia

# Default shipping origin (for rate calculation)
SHIPPING_ORIGIN_ZIP=30114

# ========================================
# DEVELOPMENT / DEBUGGING
# ========================================
# Enable debug logging (true/false)
# DEBUG=false

# Log level (error, warn, info, debug)
# LOG_LEVEL=info
